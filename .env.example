# Copy to .env.local and fill in. Never commit real values.

# Signs demo session cookies. Required in production (16+ characters). Generate with: openssl rand -hex 32
APPLICATION_SECRET=

# Public URL of the app. Decides whether session cookies are marked Secure. No domain is hardcoded in code.
APP_BASE_URL=http://localhost:3000

# Role switcher, seed data, pharmacy simulator and demo clock. Never enable for real patient data.
DEMO_MODE=true

# Google AI Studio key for the Gemini agents (server-side only).
GEMINI_API_KEY=

# Tiger Cloud (Postgres/TimescaleDB) connection string.
DATABASE_URL=

# Optional
GEMINI_MODEL=
VULTR_API_KEY=
